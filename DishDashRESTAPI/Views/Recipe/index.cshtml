@model IEnumerable<DishDashRESTAPIDatabase.Models.Recipe>

@{
    ViewData["Title"] = "Recipes";
}

<h2>Recipes</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Recipe</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Category</th>
            <th>Name</th>
            <th>Ingredients</th>
            <th>Instructions</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recipe in Model)
        {
            <tr>
                <td>@recipe.Category</td>
                <td>@recipe.Name</td>
                <td>@recipe.Ingredient</td>
                <td>@recipe.Instruction</td>
                <td>
                    <img src="@recipe.ImageUrl" alt="@recipe.Name" style="max-width:100px;" />
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-secondary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
